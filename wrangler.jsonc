// Cloudflare Worker that serves the game's static files.
// homebodi.ai is attached as a custom domain, so this Worker answers for the
// whole domain: the game lives at /game/, and / redirects there.
// Build with `npm run build` (writes dist/), deploy with `npx wrangler deploy`.
{
  "name": "cosmic-cubicle-combatants",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // /game redirects to /game/ so the page's relative links resolve.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "homebodi.ai", "custom_domain": true }
  ]
}
