// Cloudflare Worker that serves the game's static files at homebodi.ai/game/.
// It only answers the two routes below; the rest of homebodi.ai is untouched.
// Build with `npm run build` (writes dist/game/), deploy with `npx wrangler deploy`.
{
  "name": "cosmic-cubicle-combatants",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // /game redirects to /game/ so the page's relative links resolve.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "homebodi.ai/game", "zone_name": "homebodi.ai" },
    { "pattern": "homebodi.ai/game/*", "zone_name": "homebodi.ai" }
  ]
}
